# ============================================================
# ReportSaathi Frontend — Environment Variables
# Copy this file to .env.local and fill in YOUR values.
# NEVER commit .env.local to git.
# ============================================================

# ── Backend API URL (exposed to browser) ─────────────────────
# In development: http://localhost:3001
# In staging: the Vercel preview URL of the backend deployment
# In production: https://api.reportsaathi.in (or your domain)
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001

# ── App URL (used for OG tags, links, etc.) ──────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Default locale ───────────────────────────────────────────
NEXT_PUBLIC_DEFAULT_LOCALE=hi
