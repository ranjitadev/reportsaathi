# ============================================================
# ReportSaathi Backend — Environment Variables
# Copy this file to .env.local and fill in YOUR values.
# NEVER commit .env.local to git.
# ============================================================

# ── App settings ─────────────────────────────────────────────
APP_ENV=development
# NODE_ENV is set automatically by Next.js

# ── AI Provider — Google Gemini (Free Tier) ──────────────────
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Fallback AI Provider — Groq (Free Tier) ──────────────────
# Get from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
AI_PROVIDER=gemini

# ── Rate Limiting ─────────────────────────────────────────────
RATE_LIMIT_PER_IP_HOURLY=10

# ── CORS — allow this frontend origin ────────────────────────
# In development: http://localhost:3000
# In staging/prod: set to your actual frontend URL
FRONTEND_URL=http://localhost:3000
